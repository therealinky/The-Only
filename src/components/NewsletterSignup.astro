---
import { NEWSLETTER } from '../config/site';

// Hidden entirely — no markup rendered at all — until NEWSLETTER_PROVIDER is
// set to "buttondown" (see .env.example). Only
// Buttondown is wired up; a different provider would need its own branch
// here since each one's embeddable form shape differs.
const isButtondown = NEWSLETTER.provider === 'buttondown' && NEWSLETTER.buttondownUsername;
---

{
  isButtondown && (
    <section aria-labelledby="newsletter-heading" class="newsletter-signup">
      <h2 id="newsletter-heading">Get The Brief by email</h2>
      <p>Every Wednesday, a short summary of the most interesting stories from the past seven days.</p>
      <form
        action={`https://buttondown.com/api/emails/embed-subscribe/${NEWSLETTER.buttondownUsername}`}
        method="post"
        target="popupwindow"
        onsubmit={`window.open('https://buttondown.com/${NEWSLETTER.buttondownUsername}', 'popupwindow')`}
      >
        <label for="newsletter-email">Email address</label>
        <input id="newsletter-email" type="email" name="email" required autocomplete="email" />
        <input type="hidden" value="1" name="embed" />
        <button type="submit">Subscribe</button>
      </form>
      <p class="newsletter-signup__archive">
        <a href={`https://buttondown.com/${NEWSLETTER.buttondownUsername}/archive/`}>Read past issues</a>
      </p>
    </section>
  )
}
