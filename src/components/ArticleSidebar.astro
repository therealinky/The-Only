---
import type { Difficulty, Format, PatternStrength, Sentiment } from '../config/site';
import { parseCheckStatus } from '../lib/check-status';
import { slugify } from '../lib/slugify';
import CheckStatus from './CheckStatus.astro';
import DifficultyBadge from './DifficultyBadge.astro';
import PatternStrengthBadge from './PatternStrengthBadge.astro';
import SentimentBadge from './SentimentBadge.astro';

interface Summary {
  whatChanged?: string;
  whyItMatters?: string;
  bestFor?: string;
  timeToTry?: string;
}

interface BeforeYouUse {
  clientData: string;
  usageRights: string;
  disclosure: string;
  accessibility: string;
  cost: string;
}

interface Props {
  format: Format;
  dek: string;
  difficulty: Difficulty;
  tools: string[];
  beforeYouUse: BeforeYouUse;
  summary?: Summary;
  hasTutorial: boolean;
  sentiment?: Sentiment;
  patternStrength?: PatternStrength;
  communities?: string[];
}

const {
  format,
  dek,
  difficulty,
  tools,
  beforeYouUse,
  summary,
  hasTutorial,
  sentiment,
  patternStrength,
  communities = [],
} = Astro.props;
const hasSummary = Boolean(summary?.whatChanged);
const isPulse = format === 'pulse';
const checks = (
  [
    ['Client data', beforeYouUse.clientData],
    ['Usage rights', beforeYouUse.usageRights],
    ['Disclosure', beforeYouUse.disclosure],
    ['Accessibility', beforeYouUse.accessibility],
    ['Cost', beforeYouUse.cost],
  ] as const
).map(([label, value]) => ({ label, ...parseCheckStatus(value) }));
---

<aside class="article-sidebar" aria-label="At a glance">
  <div class="article-sidebar__section">
    <h2 class="article-sidebar__heading">At a glance</h2>
    {
      hasSummary ? (
        <dl>
          <div>
            <dt>What changed</dt>
            <dd>{summary!.whatChanged}</dd>
          </div>
          <div>
            <dt>Why it matters</dt>
            <dd>{summary!.whyItMatters}</dd>
          </div>
          <div>
            <dt>Best for</dt>
            <dd>{summary!.bestFor}</dd>
          </div>
          <div>
            <dt>Time to try</dt>
            <dd>{summary!.timeToTry}</dd>
          </div>
        </dl>
      ) : (
        <p>{dek}</p>
      )
    }
    {hasTutorial && <p class="article-sidebar__jump"><a href="#tutorial">Jump to the tutorial ↓</a></p>}
  </div>

  {
    isPulse ? (
      sentiment && (
        <div class="article-sidebar__section">
          <h2 class="article-sidebar__heading">The overall mood</h2>
          <SentimentBadge sentiment={sentiment} />
        </div>
      )
    ) : (
      <div class="article-sidebar__section">
        <h2 class="article-sidebar__heading">Effort to try</h2>
        <DifficultyBadge difficulty={difficulty} />
      </div>
    )
  }

  {
    isPulse && communities.length > 0 && (
      <div class="article-sidebar__section">
        <h2 class="article-sidebar__heading">Where it's happening</h2>
        <ul class="article-sidebar__tools">
          {communities.map((community) => (
            <li>{community}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    tools.length > 0 && (
      <div class="article-sidebar__section">
        <h2 class="article-sidebar__heading">Tools discussed</h2>
        <ul class="article-sidebar__tools">
          {tools.map((tool) => (
            <li>
              <a href={`/tools/${slugify(tool)}/`}>{tool}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    isPulse ? (
      patternStrength && (
        <div class="article-sidebar__section">
          <h2 class="article-sidebar__heading">How solid is this</h2>
          <PatternStrengthBadge patternStrength={patternStrength} />
        </div>
      )
    ) : (
      <div class="article-sidebar__section">
        <h2 class="article-sidebar__heading">Before you use it</h2>
        <dl>
          {checks.map(({ label, status, text }) => (
            <div>
              <dt class="check-status__row">
                <span>{label}</span>
                <CheckStatus status={status} />
              </dt>
              {text && <dd>{text}</dd>}
            </div>
          ))}
        </dl>
        <p class="check-status__key">
          <a href="/editorial-policy/#before-you-use-it">What these labels mean</a>
        </p>
      </div>
    )
  }
</aside>
