---
import { CHECK_STATUS_DESCRIPTIONS, CHECK_STATUS_LABELS, type CheckStatus } from '../config/site';

interface Props {
  status: CheckStatus;
}

const { status } = Astro.props;
---

<span class="check-status" data-status={status} title={CHECK_STATUS_DESCRIPTIONS[status]}>
  <svg class="check-status__icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
    {
      status === 'known' && (
        <>
          <circle cx="8" cy="8" r="7.25" fill="currentColor" />
          <path d="M4.75 8.25 7 10.5l4.25-4.75" fill="none" stroke="var(--check-cutout)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </>
      )
    }
    {
      status === 'not-verified' && (
        <>
          <circle cx="8" cy="8" r="6.75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.6 2" />
          <path d="M6.3 6.4a1.75 1.75 0 1 1 2.45 1.6c-.5.22-.75.6-.75 1.1v.3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="8" cy="11.6" r="0.9" fill="currentColor" />
        </>
      )
    }
    {
      status === 'not-applicable' && (
        <>
          <circle cx="8" cy="8" r="6.75" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M5 8h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </>
      )
    }
  </svg>
  {CHECK_STATUS_LABELS[status]}
</span>
