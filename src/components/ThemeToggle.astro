<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
  <span aria-hidden="true" data-theme-icon>◐</span>
</button>

<script>
  const STORAGE_KEY = 'theme';
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const icon = document.querySelector<HTMLElement>('[data-theme-icon]');

  function systemPrefersDark(): boolean {
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function currentTheme(): 'light' | 'dark' {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'light' || stored === 'dark') return stored;
    return systemPrefersDark() ? 'dark' : 'light';
  }

  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme;
    if (button) {
      button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    }
    if (icon) {
      icon.textContent = theme === 'dark' ? '◑' : '◐';
    }
  }

  applyTheme(currentTheme());

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      /* private browsing or blocked storage: theme just won't persist */
    }
    applyTheme(next);
  });
</script>
