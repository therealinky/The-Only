---
import { DISCIPLINES, type Discipline } from '../config/site';
import type { Article } from '../lib/articles';
import { slugify } from '../lib/slugify';
import ArticleCard from './ArticleCard.astro';

interface Props {
  /** All articles for this locked format (or all published articles), unfiltered by discipline. */
  articles: Article[];
  /** Link for the "All disciplines" filter. Required when the filter bar shows. */
  allHref?: string;
  /** Prefix that a discipline slug is appended to, e.g. "/discipline/" or "/try-it/". */
  disciplineBase?: string;
  /** Show the discipline filter bar. Off for lists that aren't a section, like a tool's page. */
  showFilters?: boolean;
  activeDiscipline?: Discipline;
  emptyMessage?: string;
  /** Show this many matching articles at first, with a "See more" button for the rest. */
  pageSize?: number;
}

const {
  articles,
  allHref = '/',
  disciplineBase = '/discipline/',
  showFilters = true,
  activeDiscipline,
  emptyMessage = 'No articles match this filter yet.',
  pageSize,
} = Astro.props;

const matches = (article: Article) => !activeDiscipline || article.data.disciplines.includes(activeDiscipline);
const visibleCount = articles.filter(matches).length;
let matchIndex = 0;
---

{
  showFilters && (
    <nav class="filter-bar" aria-label="Filter by discipline" data-filter-bar data-all-href={allHref} data-discipline-base={disciplineBase}>
      <ul class="filter-bar__list">
        <li>
          <a href={allHref} aria-current={!activeDiscipline ? 'page' : undefined} data-discipline="">
            All disciplines
          </a>
        </li>
        {
          DISCIPLINES.map((d) => (
            <li>
              <a
                href={`${disciplineBase}${slugify(d)}/`}
                aria-current={activeDiscipline === d ? 'page' : undefined}
                data-discipline={d}
              >
                {d}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  )
}

<p data-filter-count>
  {visibleCount} {visibleCount === 1 ? 'article' : 'articles'}
</p>

<div data-article-grid data-page-size={pageSize}>
  {
    articles.map((article) => {
      const isMatch = matches(article);
      const pagedOut = isMatch && pageSize !== undefined && matchIndex++ >= pageSize;
      return (
        <div
          data-article-item
          data-disciplines={article.data.disciplines.join('|')}
          hidden={!isMatch || undefined}
          data-paged-out={pagedOut || undefined}
        >
          <ArticleCard article={article} />
        </div>
      );
    })
  }
</div>

{
  pageSize !== undefined && (
    <div class="see-more">
      <button type="button" data-see-more hidden={visibleCount <= pageSize || undefined}>
        See more
      </button>
    </div>
  )
}
{
  pageSize !== undefined && (
    <noscript>
      <style>{'[data-article-item][data-paged-out] { display: flex; } [data-see-more] { display: none; }'}</style>
    </noscript>
  )
}

{articles.length === 0 && <p>{emptyMessage}</p>}

<script>
  // Cards fade up row by row: the rows on screen at load one after another,
  // then each further row as it scrolls into view (including cards shown by
  // "See more"). Only active when BaseLayout's head script set .reveal-cards
  // (not for reduced motion).
  {
    const root = document.documentElement;
    const revealGrid = document.querySelector<HTMLElement>('[data-article-grid]');
    if (revealGrid && root.classList.contains('reveal-cards')) {
      const ROW_STAGGER = 110;
      const MAX_DELAY = 440;
      const reveal = new IntersectionObserver(
        (entries) => {
          const arriving = entries.filter((entry) => entry.isIntersecting).map((entry) => entry.target as HTMLElement);
          // Cards sharing a top edge are one row; rows arriving together are
          // staggered top to bottom.
          const rows = [...new Set(arriving.map((card) => Math.round(card.getBoundingClientRect().top)))].sort((a, b) => a - b);
          for (const card of arriving) {
            const row = rows.indexOf(Math.round(card.getBoundingClientRect().top));
            card.style.setProperty('--reveal-delay', `${Math.min(row * ROW_STAGGER, MAX_DELAY)}ms`);
            card.classList.add('is-revealed');
            reveal.unobserve(card);
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -4% 0px' },
      );
      revealGrid.querySelectorAll('[data-article-item]').forEach((card) => reveal.observe(card));
      root.setAttribute('data-cards-ready', '');
    }
  }

  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const grid = document.querySelector<HTMLElement>('[data-article-grid]');
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  if (bar && grid) {
    const allHref = bar.dataset.allHref ?? '/';
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-article-item]'));
    const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>('a[data-discipline]'));
    const seeMore = document.querySelector<HTMLButtonElement>('[data-see-more]');
    const pageSize = Number(grid.dataset.pageSize) || Infinity;
    let shown = pageSize;

    function matchingItems() {
      return items.filter((item) => !item.hidden);
    }

    // Reveals the first `shown` matching cards and pages out the rest.
    function applyPaging() {
      const matching = matchingItems();
      matching.forEach((item, index) => item.toggleAttribute('data-paged-out', index >= shown));
      if (seeMore) seeMore.hidden = matching.length <= shown;
    }

    function applyFilter(discipline: string, href: string, push: boolean) {
      let visible = 0;
      for (const item of items) {
        const disciplines = (item.dataset.disciplines ?? '').split('|');
        const matches = discipline === '' || disciplines.includes(discipline);
        item.hidden = !matches;
        if (!matches) item.removeAttribute('data-paged-out');
        if (matches) visible += 1;
      }
      shown = pageSize;
      applyPaging();
      for (const link of links) {
        if ((link.dataset.discipline ?? '') === discipline) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      }
      if (count) {
        count.textContent = `${visible} ${visible === 1 ? 'article' : 'articles'}`;
      }
      if (push) {
        history.pushState({ discipline }, '', href);
      }
    }

    seeMore?.addEventListener('click', () => {
      const firstNew = matchingItems()[shown];
      shown += pageSize;
      applyPaging();
      // Keeps keyboard and screen-reader users at the start of what was revealed.
      firstNew?.querySelector<HTMLAnchorElement>('a.article-card__link')?.focus();
    });

    for (const link of links) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        applyFilter(link.dataset.discipline ?? '', link.getAttribute('href') ?? allHref, true);
      });
    }

    window.addEventListener('popstate', () => {
      const path = location.pathname;
      const link = links.find((l) => l.getAttribute('href') === path);
      applyFilter(link?.dataset.discipline ?? '', path, false);
    });
  }
</script>
