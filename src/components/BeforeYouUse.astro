---
interface Props {
  clientData: string;
  usageRights: string;
  disclosure: string;
  accessibility: string;
  cost: string;
}

const { clientData, usageRights, disclosure, accessibility, cost } = Astro.props;
---

<section aria-labelledby="before-you-use-heading">
  <h2 id="before-you-use-heading">Before you use it</h2>
  <dl>
    <div>
      <dt>Client data</dt>
      <dd>{clientData}</dd>
    </div>
    <div>
      <dt>Usage rights</dt>
      <dd>{usageRights}</dd>
    </div>
    <div>
      <dt>Disclosure</dt>
      <dd>{disclosure}</dd>
    </div>
    <div>
      <dt>Accessibility</dt>
      <dd>{accessibility}</dd>
    </div>
    <div>
      <dt>Cost</dt>
      <dd>{cost}</dd>
    </div>
  </dl>
</section>
