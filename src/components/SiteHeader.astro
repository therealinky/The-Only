---
import ThemeToggle from './ThemeToggle.astro';
import { NAV_ITEMS, SITE } from '../config/site';
import { getListableArticles } from '../lib/articles';

const navItems = NAV_ITEMS;
const latest = (await getListableArticles()).slice(0, 5);

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__name">{SITE.name}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__search" href="/search/">Search</a>
      <ThemeToggle />
      <details class="mobile-nav">
        <summary class="mobile-nav__trigger" aria-label="Menu">
          <span class="mobile-nav__icon" aria-hidden="true">
            <span class="mobile-nav__line"></span>
            <span class="mobile-nav__line"></span>
          </span>
        </summary>
        <nav class="mobile-nav__panel" aria-label="Main (mobile)">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>

  <div class="latest-strip">
    <div class="latest-strip__inner">
      {
        latest.length > 0 && (
          <section class="latest-strip__ticker" aria-label="Latest articles" data-latest-strip>
            <span class="latest-strip__label" aria-hidden="true">
              Latest
            </span>
            <ol class="latest-strip__track" data-latest-track>
              {latest.map((article) => (
                <li class="latest-strip__item">
                  <a href={`/articles/${article.id}/`}>
                    <span class="latest-strip__title">{article.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
            <div class="latest-strip__controls">
              <button type="button" class="latest-strip__button" data-latest-prev aria-label="Previous article" disabled>
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button type="button" class="latest-strip__button" data-latest-next aria-label="Next article">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </section>
        )
      }
    </div>
  </div>
</header>

<script>
  // The header (nav and Latest strip) stays pinned at the top for the first
  // third of the page. Past that, it slides away while the reader scrolls
  // down and slides back as soon as they scroll up. Things pinned beneath it
  // (the Toolkit's A-Z bar, the article sidebar) follow --header-offset,
  // which is the header's height while it's showing and 0 while it's hidden.
  {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (header) {
      const root = document.documentElement;
      const menu = header.querySelector<HTMLDetailsElement>('details');
      // Ignore tiny movements (trackpad jitter, momentum settling).
      const NUDGE = 6;
      let lastY = window.scrollY;
      let hidden = false;
      let queued = false;

      const setHidden = (value: boolean) => {
        hidden = value;
        header.classList.toggle('is-hidden', value);
        root.style.setProperty('--header-offset', value ? '0px' : `${header.offsetHeight}px`);
      };

      const update = () => {
        queued = false;
        const y = window.scrollY;
        const threshold = (root.scrollHeight - window.innerHeight) / 3;
        // Never hide while the mobile menu is open or something in the
        // header has keyboard focus.
        const pinned = y < threshold || menu?.open || header.contains(document.activeElement);
        if (pinned) {
          if (hidden) setHidden(false);
        } else if (y > lastY + NUDGE) {
          if (!hidden) setHidden(true);
        } else if (y < lastY - NUDGE) {
          if (hidden) setHidden(false);
        } else {
          return;
        }
        lastY = y;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      header.addEventListener('focusin', () => setHidden(false));
      const measure = () => {
        root.style.setProperty('--site-header-height', `${header.offsetHeight}px`);
        if (!hidden) root.style.setProperty('--header-offset', `${header.offsetHeight}px`);
      };
      measure();
      new ResizeObserver(measure).observe(header);
    }
  }

  // The carets step the latest-articles track one title at a time. Without
  // JS the track still scrolls sideways natively; the buttons just do
  // nothing.
  for (const strip of document.querySelectorAll<HTMLElement>('[data-latest-strip]')) {
    const track = strip.querySelector<HTMLElement>('[data-latest-track]')!;
    const prev = strip.querySelector<HTMLButtonElement>('[data-latest-prev]')!;
    const next = strip.querySelector<HTMLButtonElement>('[data-latest-next]')!;
    const items = [...track.children] as HTMLElement[];
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const update = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    // The first item whose start is past (or before) the current scroll
    // position, so each click lands cleanly on the next or previous title.
    const step = (direction: 1 | -1) => {
      const left = track.scrollLeft;
      const offsets = items.map((item) => item.offsetLeft - track.offsetLeft);
      const target =
        direction === 1
          ? offsets.find((offset) => offset > left + 1)
          : [...offsets].reverse().find((offset) => offset < left - 1);
      track.scrollTo({ left: target ?? (direction === 1 ? track.scrollWidth : 0), behavior: smooth ? 'smooth' : 'auto' });
    };

    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
