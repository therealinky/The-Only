---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../config/site';

const navItems = [
  { href: '/', label: 'Latest' },
  { href: '/try-it/', label: 'Try It' },
  { href: '/workflows/', label: 'Workflows' },
  { href: '/tools/', label: 'Tools' },
  { href: '/the-brief/', label: 'The Brief' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__name">{SITE.name}</span>
      <span class="site-header__descriptor">{SITE.descriptor}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__search" href="/search/">Search</a>
      <ThemeToggle />
      <details class="mobile-nav">
        <summary class="mobile-nav__trigger" aria-label="Menu">
          <span class="mobile-nav__icon" aria-hidden="true">
            <span class="mobile-nav__line"></span>
            <span class="mobile-nav__line"></span>
          </span>
        </summary>
        <nav class="mobile-nav__panel" aria-label="Main (mobile)">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
