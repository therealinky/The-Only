---
import SiteNavRow from './SiteNavRow.astro';
import { getListableArticles } from '../lib/articles';

const latest = (await getListableArticles()).slice(0, 5);
---

<header class="site-header">
  <SiteNavRow />

  <div class="latest-strip">
    <div class="latest-strip__inner">
      {
        latest.length > 0 && (
          <section class="latest-strip__ticker" aria-label="Latest articles" data-latest-strip>
            <span class="latest-strip__label" aria-hidden="true">
              Latest
            </span>
            <ol class="latest-strip__track" data-latest-track>
              {latest.map((article) => (
                <li class="latest-strip__item">
                  <a href={`/articles/${article.id}/`}>
                    <span class="latest-strip__title">{article.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
            <div class="latest-strip__controls">
              <button type="button" class="latest-strip__button" data-latest-prev aria-label="Previous article" disabled>
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button type="button" class="latest-strip__button" data-latest-next aria-label="Next article">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </section>
        )
      }
    </div>
  </div>
</header>

<div class="site-header-float" data-header-float inert>
  <SiteNavRow floating />
</div>

<script>
  // The header (nav and Latest strip) scrolls away with the page like any
  // other content. Once the reader is about 25% of the way down, scrolling up
  // slides in a floating copy of just the nav row; scrolling down slides it
  // away again. It also tucks away once the real header is back in view near
  // the top. Below the 25% mark, scrolling up never brings it in fresh, but
  // if it's already showing it stays while the reader keeps going up.
  // Things pinned under it (the Toolkit's A-Z bar, the article sidebar)
  // follow --header-offset: the bar's height while it's showing, else 0.
  {
    const header = document.querySelector<HTMLElement>('.site-header');
    const bar = document.querySelector<HTMLElement>('[data-header-float]');
    if (header && bar) {
      const root = document.documentElement;
      const menu = bar.querySelector<HTMLDetailsElement>('details');
      const THRESHOLD = 0.25;
      // Ignore tiny movements (trackpad jitter, momentum settling).
      const NUDGE = 6;
      let lastY = window.scrollY;
      let shown = false;
      let queued = false;

      const setShown = (value: boolean) => {
        if (shown === value) return;
        shown = value;
        bar.classList.toggle('is-shown', value);
        bar.inert = !value;
        if (!value && menu) menu.open = false;
        root.style.setProperty('--header-offset', value ? `${bar.offsetHeight}px` : '0px');
      };
      root.style.setProperty('--header-offset', '0px');

      const update = () => {
        queued = false;
        const y = window.scrollY;
        const delta = y - lastY;
        if (Math.abs(delta) < NUDGE) return;
        lastY = y;
        // Keep it while its phone menu is open or it has keyboard focus.
        if (shown && (menu?.open || bar.contains(document.activeElement))) return;
        const pastThreshold = y > (root.scrollHeight - window.innerHeight) * THRESHOLD;
        if (y <= header.offsetHeight) setShown(false);
        else if (delta > 0) setShown(false);
        else if (pastThreshold || shown) setShown(true);
      };

      window.addEventListener(
        'scroll',
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
    }
  }

  // The carets step the latest-articles track one title at a time. Without
  // JS the track still scrolls sideways natively; the buttons just do
  // nothing.
  for (const strip of document.querySelectorAll<HTMLElement>('[data-latest-strip]')) {
    const track = strip.querySelector<HTMLElement>('[data-latest-track]')!;
    const prev = strip.querySelector<HTMLButtonElement>('[data-latest-prev]')!;
    const next = strip.querySelector<HTMLButtonElement>('[data-latest-next]')!;
    const items = [...track.children] as HTMLElement[];
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const update = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    // The first item whose start is past (or before) the current scroll
    // position, so each click lands cleanly on the next or previous title.
    const step = (direction: 1 | -1) => {
      const left = track.scrollLeft;
      const offsets = items.map((item) => item.offsetLeft - track.offsetLeft);
      const target =
        direction === 1
          ? offsets.find((offset) => offset > left + 1)
          : [...offsets].reverse().find((offset) => offset < left - 1);
      track.scrollTo({ left: target ?? (direction === 1 ? track.scrollWidth : 0), behavior: smooth ? 'smooth' : 'auto' });
    };

    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
