---
// One piece of media inside an article body: an image, a GIF, a YouTube
// video, or a Lottie/dotLottie animation, with optional caption and credit.
// Articles use it as <Media ... /> (Keystatic inserts it as a "Media" block),
// usually at the end of a section. See the README's "Adding media" section.
import { readFileSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { Image, Picture } from 'astro:assets';
import { resolveImage, resolveLottie, youTubeId } from '../lib/media';

type MediaType = 'image' | 'gif' | 'youtube' | 'lottie';
type LottieTrigger = 'loop' | 'view' | 'hover' | 'click' | 'scroll';
const LOTTIE_TRIGGERS: LottieTrigger[] = ['loop', 'view', 'hover', 'click', 'scroll'];

interface Props {
  type: MediaType;
  /** Image or GIF: the uploaded file (path or just its filename). */
  image?: string | null;
  /** Lottie: the uploaded .json or .lottie file. */
  file?: string | null;
  /** YouTube: the video's link. */
  youtube?: string | null;
  /** Required. Describes the image or animation; for YouTube, the video's title. */
  alt: string;
  caption?: string | null;
  credit?: string | null;
  /** Lottie: half the column width (the default) or the full column. Phones always get full width. */
  size?: 'half' | 'full' | null;
  /**
   * Lottie: what plays it. loop (default) plays continuously with a pause
   * button; view plays once when it scrolls into view; hover plays while
   * hovered and rewinds on leave (tap on touch screens); click plays once per
   * click or tap; scroll scrubs it with the page's scroll position.
   */
  trigger?: LottieTrigger | null;
  /** Lottie, "view" trigger only: replay each time it scrolls back into view. */
  replay?: boolean | null;
}

const { type, image, file, youtube, alt, caption, credit, size, trigger: rawTrigger, replay } = Astro.props;
const trigger: LottieTrigger = rawTrigger || 'loop';
if (type === 'lottie' && !LOTTIE_TRIGGERS.includes(trigger)) {
  throw new Error(`Media block: unknown Lottie trigger "${rawTrigger}". Use ${LOTTIE_TRIGGERS.join(', ')}.`);
}
// Hover and click Lotties are controls the reader operates, so they're
// focusable buttons; the others are images.
const interactive = trigger === 'hover' || trigger === 'click';
const lottieLabel = interactive ? `${alt} (${trigger === 'hover' ? 'hover or press' : 'press'} to play)` : alt;
const where = image || file || youtube || type;

if (!alt?.trim()) {
  throw new Error(`Media block (${where}): alt text is required. Describe what it shows, or give the video's title.`);
}

// Above this, a GIF noticeably slows the page; an MP4 or animated WebP of
// the same clip is usually a fraction of the size.
const GIF_WARN_BYTES = 2 * 1024 * 1024;
// The article text column tops out around 46rem.
const sizes = '(min-width: 64rem) 46rem, 100vw';

let picture: Awaited<ReturnType<typeof resolveImage>> | undefined;
let isAnimatedGif = false;
let videoId: string | undefined;
let lottie: (ReturnType<typeof resolveLottie> & { ratio?: string }) | undefined;

if (type === 'image' || type === 'gif') {
  if (!image) throw new Error(`Media block: type "${type}" needs an image file.`);
  picture = resolveImage(image);
  if (type === 'gif' || picture.isGif) {
    const bytes = statSync(join(process.cwd(), picture.key)).size;
    if (bytes > GIF_WARN_BYTES) {
      console.warn(
        `[media] ${picture.key} is ${(bytes / 1024 / 1024).toFixed(1)} MB. Consider an MP4 or animated WebP for a lighter page.`,
      );
    }
    // Served as-is: converting a GIF would drop its animation.
    isAnimatedGif = true;
  }
} else if (type === 'youtube') {
  if (!youtube) throw new Error('Media block: type "youtube" needs a YouTube link.');
  videoId = youTubeId(youtube);
} else if (type === 'lottie') {
  if (!file) throw new Error('Media block: type "lottie" needs a .json or .lottie file.');
  lottie = resolveLottie(file);
  // Lottie JSON carries its own canvas size, so the space can be reserved
  // before the player loads. A .lottie is a zip, so it settles once loaded.
  if (lottie.isJson) {
    const { w, h } = JSON.parse(readFileSync(join(process.cwd(), lottie.key), 'utf8'));
    if (w && h) lottie.ratio = `${w} / ${h}`;
  }
} else {
  throw new Error(`Media block: unknown type "${type}". Use image, gif, youtube, or lottie.`);
}

const watchUrl = videoId ? `https://www.youtube.com/watch?v=${videoId}` : undefined;
---

<figure class:list={['media', `media--${isAnimatedGif ? 'gif' : type}`, { 'media--half': type === 'lottie' && size !== 'full' }]}>
  {
    picture && !isAnimatedGif && (
      <Picture
        src={picture.image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600].filter((w) => w <= picture!.image.width)}
        sizes={sizes}
        loading="lazy"
        decoding="async"
        class="media__frame"
      />
    )
  }
  {
    picture && isAnimatedGif && (
      <div class="media__frame media__gif" data-media-gif>
        <img
          src={picture.image.src}
          width={picture.image.width}
          height={picture.image.height}
          alt={alt}
          loading="lazy"
          decoding="async"
        />
        <canvas aria-hidden="true"></canvas>
        <button type="button" class="media__toggle" data-media-gif-toggle hidden>
          Play animation
        </button>
      </div>
    )
  }
  {
    videoId && (
      <div class="media__frame media__video" data-media-youtube={videoId} data-title={alt}>
        <a class="media__poster" href={watchUrl} aria-label={`Play video: ${alt}`}>
          <Image
            src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
            alt=""
            width={480}
            height={360}
            loading="lazy"
            decoding="async"
          />
          <span class="media__play" aria-hidden="true">
            <svg viewBox="0 0 68 48" width="68" height="48">
              <path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="currentColor" />
              <path d="M27 34V14l18 10z" fill="var(--media-play-glyph)" />
            </svg>
          </span>
        </a>
      </div>
    )
  }
  {
    lottie && (
      <div
        class:list={['media__frame', 'media__lottie', { 'is-interactive': interactive }]}
        data-media-lottie={lottie.url}
        data-trigger={trigger}
        data-replay={replay ? '' : undefined}
        role={interactive ? 'button' : 'img'}
        tabindex={interactive ? 0 : undefined}
        aria-label={lottieLabel}
        style={lottie.ratio ? `aspect-ratio: ${lottie.ratio}` : undefined}
      >
        <canvas></canvas>
        {
          trigger === 'loop' && (
            <button type="button" class="media__toggle" data-media-lottie-toggle hidden>
              Pause animation
            </button>
          )
        }
        {
          interactive && (
            <span class="media__toggle media__hint" aria-hidden="true" data-media-lottie-hint>
              {trigger === 'hover' ? 'Hover to play' : 'Click to play'}
            </span>
          )
        }
      </div>
    )
  }
  {
    (caption || credit) && (
      <figcaption class="media__caption">
        {caption && <span>{caption}</span>}
        {credit && <span class="media__credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // GIFs play for everyone except visitors who ask for reduced motion: they
  // see a still frame, drawn onto a canvas over the GIF, and a play button.
  // Pausing redraws whatever frame is showing, so it freezes in place.
  if (reduceMotion.matches) {
    for (const gif of document.querySelectorAll<HTMLElement>('[data-media-gif]')) {
      const img = gif.querySelector('img')!;
      const canvas = gif.querySelector('canvas')!;
      const toggle = gif.querySelector<HTMLButtonElement>('[data-media-gif-toggle]')!;
      gif.classList.add('is-still');
      const freeze = () => {
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        canvas.getContext('2d')?.drawImage(img, 0, 0);
        gif.classList.add('is-still');
        toggle.textContent = 'Play animation';
      };
      if (img.complete && img.naturalWidth) freeze();
      else img.addEventListener('load', freeze, { once: true });
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        if (gif.classList.contains('is-still')) {
          gif.classList.remove('is-still');
          toggle.textContent = 'Pause animation';
        } else {
          freeze();
        }
      });
    }
  }

  // YouTube stays a thumbnail and a link until someone presses play, so no
  // YouTube code loads (or tracks) before then. Uses the no-cookie player.
  for (const video of document.querySelectorAll<HTMLElement>('[data-media-youtube]')) {
    video.querySelector('a')?.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${video.dataset.mediaYoutube}?autoplay=1&rel=0`;
      iframe.title = video.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      video.replaceChildren(iframe);
      iframe.focus();
    });
  }

  // Lottie: the player (and its WebAssembly engine, served from this site)
  // only loads once an animation scrolls near view. Each animation's
  // data-trigger decides what plays it:
  //   loop   - plays continuously with a pause button
  //   view   - plays once when mostly in view (data-replay: every time)
  //   hover  - plays forward while hovered or focused, rewinds on leave;
  //            on touch screens, a tap plays it and the next tap rewinds
  //   click  - plays from the start on each click, tap, Enter, or Space
  //   scroll - its frame follows the page's scroll position
  // For reduced motion, loop and view start paused and scroll shows a still
  // final frame; hover and click still work, since the reader starts them.
  const lotties = document.querySelectorAll<HTMLElement>('[data-media-lottie]');
  if (lotties.length) {
    const loadPlayer = async () => {
      const [{ DotLottie }, { default: wasmUrl }] = await Promise.all([
        import('@lottiefiles/dotlottie-web'),
        import('@lottiefiles/dotlottie-web/dotlottie-player.wasm?url'),
      ]);
      DotLottie.setWasmUrl(wasmUrl);
      return DotLottie;
    };
    let player: ReturnType<typeof loadPlayer> | undefined;
    const noHover = window.matchMedia('(hover: none)');

    const start = async (frame: HTMLElement) => {
      const DotLottie = await (player ??= loadPlayer());
      const trigger = frame.dataset.trigger ?? 'loop';
      const isLoop = trigger === 'loop';
      const animation = new DotLottie({
        canvas: frame.querySelector('canvas')!,
        src: frame.dataset.mediaLottie,
        loop: isLoop,
        autoplay: isLoop && !reduceMotion.matches,
      });
      const lastFrame = () => Math.max(0, animation.totalFrames - 1);

      // On touch screens, "Hover to play" / "Click to play" become "Tap to play".
      const hint = frame.querySelector<HTMLElement>('[data-media-lottie-hint]');
      if (hint && noHover.matches) hint.textContent = 'Tap to play';

      animation.addEventListener('load', () => {
        if (!frame.style.aspectRatio) {
          const { width, height } = animation.animationSize();
          if (width && height) frame.style.aspectRatio = `${width} / ${height}`;
        }
        setup[trigger as keyof typeof setup]?.();
      });

      const playForward = () => {
        animation.setMode('forward');
        if (animation.currentFrame >= lastFrame()) animation.setFrame(0);
        animation.play();
      };
      const rewind = () => {
        animation.setMode('reverse');
        if (animation.currentFrame > 0) animation.play();
      };
      const onPress = (handler: () => void) => {
        frame.addEventListener('click', handler);
        frame.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          handler();
        });
      };

      const setup = {
        loop() {
          const toggle = frame.querySelector<HTMLButtonElement>('[data-media-lottie-toggle]');
          if (!toggle) return;
          const label = () => {
            toggle.textContent = animation.isPlaying ? 'Pause animation' : 'Play animation';
          };
          animation.addEventListener('play', label);
          animation.addEventListener('pause', label);
          toggle.addEventListener('click', () => (animation.isPlaying ? animation.pause() : animation.play()));
          toggle.hidden = false;
          label();
        },
        view() {
          if (reduceMotion.matches) {
            animation.setFrame(lastFrame());
            return;
          }
          const replay = 'replay' in frame.dataset;
          const inView = new IntersectionObserver(
            ([entry]) => {
              if (entry.isIntersecting) {
                animation.setFrame(0);
                animation.play();
                if (!replay) inView.disconnect();
              } else if (replay) {
                animation.stop();
              }
            },
            { threshold: 0.6 },
          );
          inView.observe(frame);
        },
        hover() {
          frame.addEventListener('pointerenter', (event) => {
            if (event.pointerType === 'mouse' || event.pointerType === 'pen') playForward();
          });
          frame.addEventListener('pointerleave', (event) => {
            if (event.pointerType === 'mouse' || event.pointerType === 'pen') rewind();
          });
          // Touch screens and keyboards: each press alternates play and rewind.
          // Keyboard focus counts as hovering, like the pointer does.
          let forward = false;
          frame.addEventListener('focus', () => {
            forward = true;
            playForward();
          });
          frame.addEventListener('blur', () => {
            forward = false;
            rewind();
          });
          const toggle = () => {
            forward = !forward;
            if (forward) playForward();
            else rewind();
          };
          frame.addEventListener('click', () => {
            if (noHover.matches) toggle();
          });
          frame.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            toggle();
          });
        },
        click() {
          onPress(() => {
            animation.setMode('forward');
            animation.setFrame(0);
            animation.play();
          });
        },
        scroll() {
          if (reduceMotion.matches) {
            animation.setFrame(lastFrame());
            return;
          }
          let queued = false;
          const scrub = () => {
            queued = false;
            const rect = frame.getBoundingClientRect();
            const viewport = window.innerHeight;
            // 0 as its top enters the bottom of the screen, 1 as its bottom
            // leaves the top.
            const progress = Math.min(1, Math.max(0, (viewport - rect.top) / (viewport + rect.height)));
            animation.setFrame(Math.round(progress * lastFrame()));
          };
          const onScroll = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(scrub);
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          scrub();
        },
      };
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          start(entry.target as HTMLElement);
        }
      },
      { rootMargin: '200px' },
    );
    lotties.forEach((frame) => observer.observe(frame));
  }
</script>
