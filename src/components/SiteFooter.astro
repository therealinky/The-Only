---
import { DISCIPLINES, NEWSLETTER, SITE } from '../config/site';
import { getAllTools, getListableArticles, getNavItems } from '../lib/articles';
import { slugify } from '../lib/slugify';

const year = new Date().getFullYear();
const navItems = await getNavItems();
const articleCount = (await getListableArticles()).length;
const toolCount = (await getAllTools()).length;
import ContactEmail from './ContactEmail.astro';

// Joins the last two words with a non-breaking space so the paragraph never
// ends on a single word ("wrong.") at any width or in any browser.
const description = SITE.description.replace(/ (\S+)$/, '\u00A0$1');
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__columns">
      <section class="site-footer__about" aria-labelledby="footer-about">
        <h2 id="footer-about" class="site-footer__name">
          <svg class="site-footer__mark" viewBox="0 0 64 64" width="40" height="40" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M16 0h32a16 16 0 0 1 16 16v32a16 16 0 0 1-16 16H16A16 16 0 0 1 0 48V16A16 16 0 0 1 16 0ZM32 12.5a19.5 19.5 0 1 0 0 39a19.5 19.5 0 1 0 0-39ZM32 21.5a10.5 10.5 0 1 1 0 21a10.5 10.5 0 1 1 0-21Z"
            />
          </svg>
          {SITE.name}
        </h2>
        <p class="site-footer__descriptor">{SITE.descriptor}</p>
        <p class="site-footer__description">{description}</p>
      </section>

      <nav class="site-footer__group" aria-labelledby="footer-read">
        <h2 id="footer-read" class="site-footer__heading">Read</h2>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__group" aria-labelledby="footer-disciplines">
        <h2 id="footer-disciplines" class="site-footer__heading">By discipline</h2>
        <ul>
          {
            DISCIPLINES.map((discipline) => (
              <li>
                <a href={`/discipline/${slugify(discipline)}/`}>{discipline}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="site-footer__group" aria-labelledby="footer-email">
        <h2 id="footer-email" class="site-footer__heading">The Brief by email</h2>
        <p>Every Wednesday, a short summary of the week's most interesting stories.</p>
        <ul>
          <li><a href="/the-brief/">Get The Brief</a></li>
          <li>
            <a href={`https://buttondown.com/${NEWSLETTER.buttondownUsername}/archive/`}>Read past issues</a>
          </li>
        </ul>
      </section>
    </div>

    <div class="site-footer__bar">
      <p>
        &copy; {year} {SITE.name} · {articleCount} articles · {toolCount} tools covered
      </p>
      <ul class="site-footer__links">
        <li><a href="/about/">About</a></li>
        <li><a href="/editorial-policy/">Editorial Policy</a></li>
        <li><ContactEmail label="Contact" /></li>
        <li><a href="/search/">Search</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="#top">Back to top ↑</a></li>
      </ul>
    </div>
  </div>

  <p class="site-footer__wordmark" aria-hidden="true">{SITE.name}</p>
</footer>
