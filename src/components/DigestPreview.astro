---
import { digestPath, getDigestWeeks, weekLabel } from '../lib/digest';

const [latest] = await getDigestWeeks();
---

{
  latest && (
    <section class="digest-preview" aria-labelledby="digest-preview-heading">
      <p class="digest-preview__eyebrow">Latest weekly digest</p>
      <h2 id="digest-preview-heading">
        <a href={digestPath(latest)}>{weekLabel(latest)}</a>
      </h2>
      <ul class="digest-preview__list">
        {latest.articles.map((article) => (
          <li>
            <a href={`/articles/${article.id}/`}>{article.data.title}</a>
          </li>
        ))}
      </ul>
      <p class="digest-preview__links">
        <a href={digestPath(latest)}>Read the full digest</a>
        <a href="/the-brief/digest/">All past digests</a>
      </p>
    </section>
  )
}
