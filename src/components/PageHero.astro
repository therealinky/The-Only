---
interface Props {
  /** Small label above the big stacked headline, e.g. the nav label. */
  eyebrow: string;
  /** The big stacked headline, one word (or short phrase) per line. */
  lines: string[];
  /** Shown inside the frosted-glass panel. */
  subtitle: string;
  variant: 'purple' | 'rose' | 'sage' | 'blue' | 'gold' | 'copper';
}

const { eyebrow, lines, subtitle, variant } = Astro.props;

// The hero "swoosh" — a wind-carried streak of cloud arcing across the
// gradient. Built as a tapered ribbon along a bezier spine (0 width at
// both ends, fullest in the middle) rather than a flat shape, so it reads
// as fluid and wisp-thin rather than a solid cutout.
interface Point {
  x: number;
  y: number;
}

function bezierPoint(t: number, p0: Point, p1: Point, p2: Point, p3: Point): Point {
  const mt = 1 - t;
  return {
    x: mt ** 3 * p0.x + 3 * mt ** 2 * t * p1.x + 3 * mt * t ** 2 * p2.x + t ** 3 * p3.x,
    y: mt ** 3 * p0.y + 3 * mt ** 2 * t * p1.y + 3 * mt * t ** 2 * p2.y + t ** 3 * p3.y,
  };
}

function bezierTangent(t: number, p0: Point, p1: Point, p2: Point, p3: Point): Point {
  const mt = 1 - t;
  return {
    x: 3 * mt ** 2 * (p1.x - p0.x) + 6 * mt * t * (p2.x - p1.x) + 3 * t ** 2 * (p3.x - p2.x),
    y: 3 * mt ** 2 * (p1.y - p0.y) + 6 * mt * t * (p2.y - p1.y) + 3 * t ** 2 * (p3.y - p2.y),
  };
}

// Builds a closed ribbon outline: samples points along the spine curve,
// offsets each one perpendicular to the curve's direction by a width that
// eases from 0 at both ends up to `maxWidth` at the middle, then walks
// the "top" offsets forward and the "bottom" offsets back to close the
// loop. More samples than you'd think are needed purely so the tapered
// tips stay smooth once the noise-displacement filter roughens them.
function buildRibbonPath(spine: [Point, Point, Point, Point], maxWidth: number, samples = 32): string {
  const [p0, p1, p2, p3] = spine;
  const top: Point[] = [];
  const bottom: Point[] = [];

  for (let i = 0; i <= samples; i++) {
    const t = i / samples;
    const point = bezierPoint(t, p0, p1, p2, p3);
    const tangent = bezierTangent(t, p0, p1, p2, p3);
    const len = Math.hypot(tangent.x, tangent.y) || 1;
    const nx = -tangent.y / len;
    const ny = tangent.x / len;
    // Smootherstep-shaped taper (0 at the ends, 1 at the middle) reads
    // softer than a plain sine — it eases in and out at the tips instead
    // of tapering at a constant rate.
    const ease = Math.sin(Math.PI * t) ** 1.4;
    const width = maxWidth * ease;
    top.push({ x: point.x + nx * width, y: point.y + ny * width });
    bottom.push({ x: point.x - nx * width, y: point.y - ny * width });
  }

  const round = (n: number) => n.toFixed(1);
  const forward = top.map((p, i) => `${i === 0 ? 'M' : 'L'}${round(p.x)},${round(p.y)}`).join(' ');
  const back = bottom
    .slice()
    .reverse()
    .map((p) => `L${round(p.x)},${round(p.y)}`)
    .join(' ');
  return `${forward} ${back} Z`;
}

// One shared spine, arcing up and to the right like a gust crossing the
// frame. Three ribbons trace it at decreasing width/opacity, offset
// slightly, for the layered, fibrous look of real wind-combed cirrus.
const swooshSpine: [Point, Point, Point, Point] = [
  { x: 40, y: 340 },
  { x: 430, y: 40 },
  { x: 830, y: 30 },
  { x: 1180, y: 210 },
];
const swooshRibbons = [
  { width: 78, opacity: 0.5, dx: 0, dy: 0 },
  { width: 48, opacity: 0.32, dx: 30, dy: 34 },
  { width: 26, opacity: 0.22, dx: -20, dy: -26 },
];
---

<header class={`page-hero page-hero--${variant}`}>
  <div class="page-hero__gradient" aria-hidden="true"></div>
  <svg class="page-hero__swoosh" viewBox="0 0 1200 600" preserveAspectRatio="xMaxYMin slice" aria-hidden="true">
    <defs>
      <linearGradient id="page-hero-swoosh-fade">
        <stop offset="0%" style="stop-color: var(--hero-swoosh); stop-opacity: 0" />
        <stop offset="18%" style="stop-color: var(--hero-swoosh); stop-opacity: 0.85" />
        <stop offset="50%" style="stop-color: var(--hero-swoosh); stop-opacity: 1" />
        <stop offset="82%" style="stop-color: var(--hero-swoosh); stop-opacity: 0.85" />
        <stop offset="100%" style="stop-color: var(--hero-swoosh); stop-opacity: 0" />
      </linearGradient>
      {/* A little fractal-noise displacement, stretched mostly along the
          direction of travel, breaks the ribbon's edges into soft fibers
          instead of a perfectly smooth vector outline — then a blur pass
          knocks off anything that still reads as noise rather than mist. */}
      <filter id="page-hero-swoosh-filter" x="-40%" y="-40%" width="180%" height="180%">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.05" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="20" xChannelSelector="R" yChannelSelector="G" />
        <feGaussianBlur stdDeviation="7" />
      </filter>
    </defs>
    <g filter="url(#page-hero-swoosh-filter)" fill="url(#page-hero-swoosh-fade)">
      {
        swooshRibbons.map(({ width, opacity, dx, dy }) => (
          <path d={buildRibbonPath(swooshSpine, width)} opacity={opacity} transform={`translate(${dx} ${dy})`} />
        ))
      }
    </g>
  </svg>
  <div class="page-hero__grain" aria-hidden="true"></div>

  <div class="page-hero__content">
    <p class="page-hero__eyebrow">{eyebrow}</p>
    <h1 class="page-hero__title">
      {
        lines.map((line) => (
          <span class="page-hero__line">
            <span class="page-hero__line-echo" aria-hidden="true">
              {line}
            </span>
            <span class="page-hero__line-fill">{line}</span>
          </span>
        ))
      }
    </h1>
    <div class="page-hero__glass">
      <p>{subtitle}</p>
    </div>
  </div>

  <div class="page-hero__fade" aria-hidden="true"></div>
</header>
