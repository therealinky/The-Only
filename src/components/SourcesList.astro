---
import { formatDate } from '../lib/format-date';

interface Source {
  title: string;
  url: string;
  accessed: Date;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section aria-labelledby="sources-heading">
      <h2 id="sources-heading">Sources</h2>
      <ul>
        {sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer">
              {source.title}
            </a>{' '}
            — accessed <time datetime={source.accessed.toISOString()}>{formatDate(source.accessed)}</time>
          </li>
        ))}
      </ul>
    </section>
  )
}
