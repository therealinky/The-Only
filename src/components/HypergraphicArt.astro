---
// Article hero art — see src/lib/hypergraphy.ts for how the motif + glyph
// scatter is generated. Purely decorative (the title/dek already carry the
// information), so it's hidden from assistive tech.
import type { Discipline } from '../config/site';
import { buildHypergraphicArt, GRADIENT_PAIRS, HYPERGRAPHY_CANVAS } from '../lib/hypergraphy';

interface Props {
  slug: string;
  disciplines: readonly Discipline[];
}

const { slug, disciplines } = Astro.props;
const { gradientVariant, motifPaths, glyphs } = buildHypergraphicArt(slug, disciplines);
const [hueA, hueB] = GRADIENT_PAIRS[gradientVariant];
const { width, height, motifBox } = HYPERGRAPHY_CANVAS;
const iridescentId = `hg-iridescent-${slug}`;

const motifScale = Math.min(motifBox.w, motifBox.h) / 100;
const motifX = motifBox.x + (motifBox.w - 100 * motifScale) / 2;
const motifY = motifBox.y + (motifBox.h - 100 * motifScale) / 2;

let stepIndex = 0;
const nextDelay = (stepMs: number) => `${stepIndex++ * stepMs}ms`;
---

<div class="hg-art" style={`--hg-hue-a: var(${hueA}); --hg-hue-b: var(${hueB})`} aria-hidden="true">
  <div class="hg-art__wash"></div>
  <div class="hg-art__grain"></div>
  <svg class="hg-art__svg" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="xMidYMid meet" style={`--hg-gradient: url(#${iridescentId})`}>
    <defs>
      {
        /* objectBoundingBox (the default) instead of userSpaceOnUse: each path is
           nested inside its own translate/rotate/scale group (motif, or one per
           glyph), and userSpaceOnUse coordinates are read in that local,
           already-transformed space, so every shape ended up sampling near the
           same edge of one global gradient instead of showing its own sweep.
           objectBoundingBox maps 0-1 to each element's own bounding box, so
           every mark, however small, shows the full color sweep across itself. */
      }
      <linearGradient id={iridescentId} x1="0" y1="0" x2="1" y2="0.6">
        <stop offset="0%" stop-color="var(--hero-purple)" />
        <stop offset="20%" stop-color="var(--hero-blue)" />
        <stop offset="40%" stop-color="var(--hero-sage)" />
        <stop offset="60%" stop-color="var(--hero-gold)" />
        <stop offset="80%" stop-color="var(--hero-rose)" />
        <stop offset="100%" stop-color="var(--hero-purple)" />
      </linearGradient>
    </defs>
    <g transform={`translate(${motifX} ${motifY}) scale(${motifScale})`}>
      {
        motifPaths.map(({ d, filled }) => (
          <path
            d={d}
            pathLength="1"
            class={filled ? 'hg-path hg-path--fill' : 'hg-path hg-path--draw'}
            style={`--hg-delay: ${nextDelay(130)}`}
          />
        ))
      }
    </g>
    {
      glyphs.map(({ d, kind, x, y, rotate, scale }) => (
        <g transform={`translate(${x} ${y}) rotate(${rotate}) scale(${scale})`}>
          <path
            d={d}
            pathLength="1"
            class={kind === 'dot' ? 'hg-path hg-path--fill hg-glyph' : 'hg-path hg-path--draw hg-glyph'}
            style={`--hg-delay: ${nextDelay(90)}`}
          />
        </g>
      ))
    }
  </svg>
</div>

<script>
  const items = document.querySelectorAll<HTMLElement>('.hg-art');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in-view');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('is-in-view'));
  }
</script>
