---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config/site';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/hypergraphy.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImagePath?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  ogImagePath = '/og/default.png',
  structuredData,
} = Astro.props;

const pageTitle = title === SITE.name ? `${SITE.name} — ${SITE.descriptor}` : `${title} — ${SITE.name}`;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImageURL = new URL(ogImagePath, SITE.url);
const structuredDataList = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Applied before first paint to avoid a flash of the wrong theme.
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {
        /* private browsing or blocked storage: falls back to prefers-color-scheme */
      }
      // Article cards start hidden and fade in row by row (ArticleListing.astro).
      // Set here, before first paint, so cards never flash in then vanish. Skipped
      // for reduced motion; and if the reveal script hasn't started within a few
      // seconds (blocked, or failed), the cards are simply shown.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var root = document.documentElement;
        root.classList.add('reveal-cards');
        setTimeout(function () {
          if (!root.hasAttribute('data-cards-ready')) root.classList.remove('reveal-cards');
        }, 3000);
      }
    </script>
    <script is:inline>
      // Page transitions (the CSS opt-in is the inline <style> just below). The browser
      // cross-fades the whole page; these hooks add the two touches CSS alone
      // can't: the clicked card's art morphing into the article's banner, and
      // the header staying put. Two elements with the same name on a page cancel
      // the whole transition, so only the clicked card gets the name here (and
      // the article page's own banner gives it up when leaving to another one).
      window.addEventListener('pageswap', function (e) {
        if (!e.viewTransition) return;
        var header = document.querySelector('.site-header');
        if (header && window.scrollY > header.offsetHeight) {
          header.style.viewTransitionName = 'none';
        }
        var to = e.activation && e.activation.entry && e.activation.entry.url;
        if (!to) return;
        var path = new URL(to).pathname;
        if (path.indexOf('/articles/') !== 0) return;
        var link = document.querySelector('.article-card__link[href="' + path + '"]');
        var art = link && link.closest('.article-card') && link.closest('.article-card').querySelector('.article-card__art');
        if (art) {
          art.style.viewTransitionName = 'article-art';
          var banner = document.querySelector('.hg-art');
          if (banner) banner.style.viewTransitionName = 'none';
        }
      });
    </script>
    <!-- Page transitions: cross-fade between pages, header held in place, a
         clicked card's art morphing into the article's banner (names are set by
         the script above and the .hg-art rule below). Inline so it is in the first render of every page:
         the browser decides whether to transition before bundled CSS arrives.
         Browsers without support navigate normally; reduced motion opts out. -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }

        .site-header {
          view-transition-name: site-header;
        }

        /* One banner per article page, so a fixed name is safe. */
        .hg-art {
          view-transition-name: article-art;
        }

        ::view-transition-group(root) {
          animation-duration: 260ms;
        }

        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        ::view-transition-group(article-art) {
          animation-duration: 520ms;
          animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
          z-index: 5;
        }

        /* Crop rather than stretch while the square list thumbnails grow into the
           wide banner. */
        ::view-transition-old(article-art),
        ::view-transition-new(article-art) {
          height: 100%;
          object-fit: cover;
        }

        ::view-transition-group(site-header) {
          animation-duration: 0s;
        }
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="-vO2BxmBrhJbNCj5xhP-5m4M4ye1f6TYX6CA9ADlAjg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    {
      structuredDataList.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }

    {
      // Cloudflare Web Analytics — cookieless, no visitor tracking. Only loaded in
      // production builds so local dev and previews don't pollute the numbers.
      import.meta.env.PROD && (
        <script
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "a106b3dd127c406cbe9b06db48d510a7"}'
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
