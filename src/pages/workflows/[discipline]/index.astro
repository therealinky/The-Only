---
import ArticleListing from '../../../components/ArticleListing.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { DISCIPLINES, type Discipline } from '../../../config/site';
import { filterByDiscipline, filterByFormat, getListableArticles } from '../../../lib/articles';
import { slugify } from '../../../lib/slugify';

export async function getStaticPaths() {
  return DISCIPLINES.map((discipline) => ({
    params: { discipline: slugify(discipline) },
    props: { discipline },
  }));
}

const { discipline } = Astro.props as { discipline: Discipline };
const articles = filterByFormat(await getListableArticles(), 'workflow');
const intro = `Repeatable, step-by-step AI workflows for ${discipline}.`;
---

<BaseLayout
  title={`${discipline} — Workflows`}
  description={intro}
  noindex={filterByDiscipline(articles, discipline).length === 0}
>
  <h1>Workflows: {discipline}</h1>
  <p>{intro}</p>
  <ArticleListing
    articles={articles}
    allHref="/workflows/"
    disciplineBase="/workflows/"
    activeDiscipline={discipline}
    emptyMessage="No Workflow articles match this filter yet."
  />
</BaseLayout>
