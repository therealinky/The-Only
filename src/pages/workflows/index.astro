---
import ArticleListing from '../../components/ArticleListing.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterByFormat, getListableArticles } from '../../lib/articles';

const articles = filterByFormat(await getListableArticles(), 'workflow');
---

<BaseLayout title="Workflows" description="Repeatable, step-by-step AI workflows for working designers.">
  <PageHero
    eyebrow="Workflows"
    lines={['Paths &', 'Patterns']}
    subtitle='There is no single "correct" workflow. In design, the only rule is that anything goes. Explore the shifting workflow patterns emerging across design communities today.'
    variant="sage"
  />
  <ArticleListing
    articles={articles}
    allHref="/workflows/"
    disciplineBase="/workflows/"
    emptyMessage="No Workflow articles match this filter yet."
  />
</BaseLayout>
