---
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getListableArticles } from '../../lib/articles';
import { slugify } from '../../lib/slugify';

// Every tool with how many published articles discuss it, grouped under
// its first letter (anything not A–Z goes under "#").
const counts = new Map<string, number>();
for (const article of await getListableArticles()) {
  for (const tool of article.data.tools) counts.set(tool, (counts.get(tool) ?? 0) + 1);
}
const tools = [...counts.keys()].sort((a, b) => a.localeCompare(b));

const letterOf = (tool: string) => {
  const first = tool.charAt(0).toUpperCase();
  return first >= 'A' && first <= 'Z' ? first : '#';
};
const groups = new Map<string, string[]>();
for (const tool of tools) {
  const letter = letterOf(tool);
  groups.set(letter, [...(groups.get(letter) ?? []), tool]);
}

const alphabet = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', ...(groups.has('#') ? ['#'] : [])];
const anchor = (letter: string) => `tools-${letter === '#' ? 'other' : letter.toLowerCase()}`;
const plural = (n: number) => `${n} ${n === 1 ? 'article' : 'articles'}`;
---

<BaseLayout title="The Toolkit" description="Every tool discussed on The Only, linked to the articles that cover it.">
  <PageHero
    eyebrow="The Toolkit"
    lines={['Tools of', 'The Trade']}
    subtitle="Every tool we've covered, linked to the articles that discuss it."
    variant="copper"
  />
  {
    tools.length === 0 ? (
      <p>No tools indexed yet.</p>
    ) : (
      <>
        <nav class="az-bar" aria-label="Jump to letter">
          <ol class="az-bar__list">
            {alphabet.map((letter) => (
              <li>
                {groups.has(letter) ? (
                  <a href={`#${anchor(letter)}`}>{letter}</a>
                ) : (
                  <span aria-hidden="true">{letter}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>

        <p class="tool-index__total">
          {tools.length} tools, A to Z. The number beside each is how many articles cover it.
        </p>

        <div class="tool-index">
          {[...groups].map(([letter, letterTools]) => (
            <section class="tool-index__group" id={anchor(letter)} aria-labelledby={`${anchor(letter)}-heading`}>
              <h2 class="tool-index__letter" id={`${anchor(letter)}-heading`}>
                {letter}
              </h2>
              <ul class="tool-index__list">
                {letterTools.map((tool) => (
                  <li>
                    <a href={`/tools/${slugify(tool)}/`}>
                      <span class="tool-index__name">{tool}</span>
                      <span class="tool-index__count" aria-label={plural(counts.get(tool)!)}>
                        {counts.get(tool)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>

<script>
  // A jumped-to letter has to land just under the letter bar, whose height
  // changes with the viewport (it's two rows on phones), so measure it. The
  // header's own height is measured in SiteHeader.astro.
  const root = document.documentElement;
  const measure = (selector: string, property: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (!element) return;
    const set = () => root.style.setProperty(property, `${element.offsetHeight}px`);
    new ResizeObserver(set).observe(element);
    set();
  };
  measure('.az-bar', '--az-bar-height');
</script>
