---
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTools } from '../../lib/articles';
import { slugify } from '../../lib/slugify';

const tools = await getAllTools();
---

<BaseLayout title="The Toolkit" description="Every tool discussed on The Only, linked to the articles that cover it.">
  <PageHero
    eyebrow="The Toolkit"
    lines={['Tools of', 'The Trade']}
    subtitle="Every tool we've covered, linked to the articles that discuss it."
    variant="copper"
  />
  {
    tools.length === 0 ? (
      <p>No tools indexed yet.</p>
    ) : (
      <ul>
        {tools.map((tool) => (
          <li>
            <a href={`/tools/${slugify(tool)}/`}>{tool}</a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
