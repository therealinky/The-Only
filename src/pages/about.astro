---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FORMAT_DESCRIPTIONS, FORMAT_LABELS, FORMATS, SITE } from '../config/site';
---

<BaseLayout title="About" description={`About ${SITE.name}: ${SITE.descriptor}.`}>
  <h1>About {SITE.name}</h1>
  <p><strong>{SITE.descriptor}.</strong></p>
  <p>
    {SITE.name} is a small field guide for working web, brand, UI/UX, motion, and interactive designers who want to
    stay current on AI without spending hours following announcements or taking courses.
  </p>
  <p>Most articles answer four questions, though not every format needs an answer to all of them:</p>
  <ul>
    <li><strong>What changed</strong> — the development itself, stated plainly.</li>
    <li><strong>Why a designer should care</strong> — the practical stakes, not the hype.</li>
    <li><strong>What is worth trying</strong> — concrete next steps, when there are any.</li>
    <li>
      <strong>What to watch out for</strong> — client data, usage rights, disclosure, accessibility, and cost, where
      relevant.
    </li>
  </ul>
  <p>We publish {FORMATS.length} formats:</p>
  <ul>
    {
      FORMATS.map((format) => (
        <li>
          <strong>{FORMAT_LABELS[format]}</strong> — {FORMAT_DESCRIPTIONS[format]}
        </li>
      ))
    }
  </ul>
  <p>
    Read our <a href="/editorial-policy/">Editorial Policy</a> for how we source, review, and label evidence.
  </p>
</BaseLayout>
