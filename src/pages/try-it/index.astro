---
import ArticleListing from '../../components/ArticleListing.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getListableArticles, filterByFormat } from '../../lib/articles';

const articles = filterByFormat(await getListableArticles(), 'test');
---

<BaseLayout
  title="Try It"
  description="Hands-on assessments of AI tools and features for working designers."
>
  <h1>Try It</h1>
  <p>Hands-on assessments — what we tested, what worked, and what to watch for.</p>
  <ArticleListing
    articles={articles}
    allHref="/try-it/"
    disciplineBase="/try-it/"
    emptyMessage="No Test articles match this filter yet."
  />
</BaseLayout>
