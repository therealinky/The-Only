---
import ArticleListing from '../../../components/ArticleListing.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { DISCIPLINE_INTROS, DISCIPLINES, type Discipline } from '../../../config/site';
import { filterByDiscipline, getListableArticles } from '../../../lib/articles';
import { slugify } from '../../../lib/slugify';

export async function getStaticPaths() {
  return DISCIPLINES.map((discipline) => ({
    params: { discipline: slugify(discipline) },
    props: { discipline },
  }));
}

const { discipline } = Astro.props as { discipline: Discipline };
const articles = await getListableArticles();
const intro = DISCIPLINE_INTROS[discipline];
---

<BaseLayout
  title={`${discipline} — Latest`}
  description={intro}
  noindex={filterByDiscipline(articles, discipline).length === 0}
>
  <h1>Latest: {discipline}</h1>
  <p>{intro}</p>
  <ArticleListing
    articles={articles}
    allHref="/"
    disciplineBase="/discipline/"
    activeDiscipline={discipline}
    pageSize={9}
  />
</BaseLayout>
