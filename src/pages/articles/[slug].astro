---
import { render } from 'astro:content';
import ArticleBanners from '../../components/ArticleBanners.astro';
import ArticleSidebar from '../../components/ArticleSidebar.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import FormatBadge from '../../components/FormatBadge.astro';
import HypergraphicArt from '../../components/HypergraphicArt.astro';
import Media from '../../components/Media.astro';
import SourcesList from '../../components/SourcesList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRenderableArticles } from '../../lib/articles';
import { formatDate } from '../../lib/format-date';
import { getReadingTime } from '../../lib/read-time';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const articles = await getRenderableArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { data } = article;
const isWithdrawn = data.status === 'withdrawn';
const { Content, headings } = await render(article);
const hasTutorial = headings.some((h) => h.slug === 'tutorial');
const readingTime = getReadingTime(article.body ?? data.dek);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.dek,
  datePublished: data.publishedAt.toISOString(),
  dateModified: data.updatedAt.toISOString(),
  author: { '@type': 'Person', name: data.author },
  ...(data.reviewedBy !== SITE.defaultReviewedBy
    ? { editor: { '@type': 'Person', name: data.reviewedBy } }
    : {}),
};
---

<BaseLayout
  title={data.title}
  description={data.dek}
  ogType="article"
  ogImagePath={`/og/${article.id}.png`}
  noindex={isWithdrawn}
  structuredData={isWithdrawn ? undefined : structuredData}
>
  <article data-pagefind-body={isWithdrawn ? undefined : true}>
    <ArticleBanners article={article} />

    <header>
      <div class="article-card__meta">
        <FormatBadge format={data.format} />
        <EvidenceBadge evidence={data.evidence} />
      </div>
      <h1>{data.title}</h1>
      <p>{data.dek}</p>
      <p class="article-card__disciplines">{data.disciplines.join(', ')} · {readingTime} min read</p>
    </header>

    {
      !isWithdrawn && (
        <HypergraphicArt slug={article.id} body={article.body ?? data.dek} motif={data.art} />
      )
    }

    {
      isWithdrawn ? (
        <div class="notice notice--withdrawn" role="note">
          <p>
            <strong>This article has been withdrawn</strong> as of {formatDate(data.updatedAt)}.
          </p>
          <p>{data.withdrawnNote}</p>
        </div>
      ) : (
        <div class="article-layout">
          <ArticleSidebar
            format={data.format}
            dek={data.dek}
            difficulty={data.difficulty}
            tools={data.tools}
            beforeYouUse={data.beforeYouUse}
            summary={data.summary}
            hasTutorial={hasTutorial}
            sentiment={data.sentiment}
            patternStrength={data.patternStrength}
            communities={data.communities}
          />

          <div class="article-main">
            <div class="article-body">
              <Content components={{ Media }} />
            </div>

            <SourcesList sources={data.sources} />

            <footer>
              <p>
                By {data.author} · Reviewed by {data.reviewedBy}
              </p>
              <p>
                Published <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
                {data.updatedAt.getTime() !== data.publishedAt.getTime() && (
                  <>
                    {' '}
                    · Updated <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time>
                  </>
                )}
                {' '}· Last verified{' '}
                <time datetime={data.lastVerified.toISOString()}>{formatDate(data.lastVerified)}</time>
              </p>
            </footer>
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>
