---
// Unlisted helper for the manual weekly send from Buttondown's free plan:
// nothing links here, it's kept out of search engines and the sitemap.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { buildDigestEmail, digestPath, getDigestWeeks, weekLabel, type DigestWeek } from '../../../../lib/digest';

export async function getStaticPaths() {
  const weeks = await getDigestWeeks();
  return weeks.map((week) => ({ params: { week: week.slug }, props: { week } }));
}

const { week } = Astro.props as { week: DigestWeek };
const email = buildDigestEmail(week);
---

<BaseLayout title={`Digest email: ${weekLabel(week)}`} description="Copy-ready version of this week's digest email." noindex>
  <p class="digest-eyebrow"><a href={digestPath(week)}>{weekLabel(week)}</a></p>
  <h1>Digest email</h1>
  <p>
    To send this week's digest, start a new email in Buttondown, then copy the subject and the email from here into
    it.
  </p>

  <div class="digest-email">
    <div class="digest-email__row">
      <span class="digest-email__label">Subject</span>
      <span class="digest-email__subject" data-email-subject>{email.subject}</span>
      <button type="button" data-copy="subject">Copy subject</button>
    </div>
    <div class="digest-email__row">
      <span class="digest-email__label">Email</span>
      <button type="button" data-copy="body">Copy email</button>
      <span class="digest-email__status" role="status" data-copy-status></span>
    </div>
    <div class="digest-email__preview" data-email-html set:html={email.html} />
    <details>
      <summary>Plain Markdown version</summary>
      <pre data-email-markdown>{email.markdown}</pre>
    </details>
  </div>
</BaseLayout>

<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  const subject = document.querySelector<HTMLElement>('[data-email-subject]')?.textContent ?? '';
  const html = document.querySelector<HTMLElement>('[data-email-html]')?.innerHTML ?? '';
  const markdown = document.querySelector<HTMLElement>('[data-email-markdown]')?.textContent ?? '';

  const report = (message: string) => {
    if (status) status.textContent = message;
  };

  document.querySelector('[data-copy="subject"]')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(subject);
      report('Subject copied.');
    } catch {
      report("Couldn't copy automatically. Select the subject text instead.");
    }
  });

  // Writes both formats, so a rich-text editor gets real headings and links
  // and a plain or Markdown editor gets the Markdown version.
  document.querySelector('[data-copy="body"]')?.addEventListener('click', async () => {
    try {
      if ('ClipboardItem' in window) {
        await navigator.clipboard.write([
          new ClipboardItem({
            'text/html': new Blob([html], { type: 'text/html' }),
            'text/plain': new Blob([markdown], { type: 'text/plain' }),
          }),
        ]);
      } else {
        await navigator.clipboard.writeText(markdown);
      }
      report('Email copied. Paste it into the body of your Buttondown email.');
    } catch {
      report("Couldn't copy automatically. Select the preview below instead.");
    }
  });
</script>
