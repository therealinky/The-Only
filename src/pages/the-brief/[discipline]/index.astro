---
import ArticleListing from '../../../components/ArticleListing.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { DISCIPLINES, type Discipline } from '../../../config/site';
import { filterByDiscipline, filterByFormat, getListableArticles } from '../../../lib/articles';
import { slugify } from '../../../lib/slugify';

export async function getStaticPaths() {
  return DISCIPLINES.map((discipline) => ({
    params: { discipline: slugify(discipline) },
    props: { discipline },
  }));
}

const { discipline } = Astro.props as { discipline: Discipline };
const articles = filterByFormat(await getListableArticles(), 'brief');
const intro = `Concise, sourced updates on what changed in AI for ${discipline}.`;
---

<BaseLayout
  title={`${discipline} — The Brief`}
  description={intro}
  noindex={filterByDiscipline(articles, discipline).length === 0}
>
  <h1>The Brief: {discipline}</h1>
  <p>{intro}</p>
  <ArticleListing
    articles={articles}
    allHref="/the-brief/"
    disciplineBase="/the-brief/"
    activeDiscipline={discipline}
    emptyMessage="No Brief articles match this filter yet."
  />
</BaseLayout>
