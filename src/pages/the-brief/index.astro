---
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NEWSLETTER } from '../../config/site';

const showArchive = NEWSLETTER.provider === 'buttondown' && Boolean(NEWSLETTER.buttondownUsername);
---

<BaseLayout
  title="The Brief"
  description="The Brief is a short email every Wednesday with the week's most interesting AI-for-designers stories."
>
  <PageHero
    eyebrow="By email"
    lines={['The', 'Brief']}
    subtitle="Every Wednesday, a short summary of the week's most interesting stories."
    variant="gold"
  />
  <NewsletterSignup />
  {
    showArchive && (
      <section class="brief-archive" aria-labelledby="brief-archive-heading">
        <h2 id="brief-archive-heading">Not sure yet? Read past issues</h2>
        <p>See exactly what lands in your inbox every Wednesday.</p>
        <a class="button-outline" href={`https://buttondown.com/${NEWSLETTER.buttondownUsername}/archive/`}>
          Read past issues
        </a>
      </section>
    )
  }
</BaseLayout>
