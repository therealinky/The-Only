---
import ArticleListing from '../components/ArticleListing.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { getListableArticles } from '../lib/articles';

const articles = await getListableArticles();
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <PageHero
    eyebrow="Latest"
    lines={["What's", 'New']}
    subtitle="New developments worth knowing about: what changed, why it matters, and what to try."
    variant="purple"
  />
  <p><a href="/search/">Search all articles</a></p>
  <ArticleListing articles={articles} allHref="/" disciplineBase="/discipline/" />
</BaseLayout>
