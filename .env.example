# Copy this file to .env and adjust as needed. Never commit .env itself.

# Canonical site URL, used for canonical tags, sitemap, RSS, and Open Graph.
# Defaults to http://localhost:4321 if unset.
SITE_URL=http://localhost:4321

# Set to "true" to include example: true placeholder articles in a build.
# Leave unset (or "false") for a real production build.
SHOW_EXAMPLES=false

# The Brief email signup. No signup form is shown, and no email addresses are
# collected, until NEWSLETTER_PROVIDER is set to "buttondown" (the only
# provider wired up). The Buttondown username defaults to "theonly"; set
# NEWSLETTER_BUTTONDOWN_USERNAME only to override it. See
# NewsletterSignup.astro and the README.
NEWSLETTER_PROVIDER=
NEWSLETTER_BUTTONDOWN_USERNAME=
