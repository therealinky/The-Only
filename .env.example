# Copy this file to .env and adjust as needed. Never commit .env itself.

# Canonical site URL, used for canonical tags, sitemap, RSS, and Open Graph.
# Defaults to http://localhost:4321 if unset.
SITE_URL=http://localhost:4321

# Set to "true" to include example: true placeholder articles in a build.
# Leave unset (or "false") for a real production build.
SHOW_EXAMPLES=false

# Weekly digest signup — intentionally unset. No signup form is shown, and no
# email addresses are collected, until this names a real provider. See
# NewsletterSignup.astro and the README before setting this.
NEWSLETTER_PROVIDER=
